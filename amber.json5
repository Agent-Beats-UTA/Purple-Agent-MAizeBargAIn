{
  manifest_version: "0.1.0",
  program: {
    image: "ghcr.io/agent-beats-uta/purple-agent-maizebargain:latest",
    entrypoint: ["uv", "run", "server.py", "--host", "0.0.0.0", "--port", "9018"],
    env: {
      LLM_PROVIDER: "gemini",
      GEMINI_API_KEY: "${config.gemini_api_key}",
    },
    network: {
      endpoints: [
        { name: "endpoint", port: 9018 }
      ]
    }
  },
  config_schema: {
    type: "object",
    properties: {
      gemini_api_key: { type: "string", secret: true },
    },
    required: ["gemini_api_key"],
    additionalProperties: false,
  },
  provides: {
    a2a: { kind: "a2a", endpoint: "endpoint" }
  },
  exports: {
    a2a: "a2a"
  }
}
