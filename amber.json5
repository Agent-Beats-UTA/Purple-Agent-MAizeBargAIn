{
  manifest_version: "0.3.0",
  program: {
    image: "ghcr.io/agent-beats-uta/purple-agent-maizebargain:latest",
    env: {
      GEMINI_API_KEY: "${config.gemini_api_key}",
      LLM_PROVIDER: "gemini",
    },
    network: {
      endpoints: [{ name: "a2a", port: 9018 }],
    },
  },
  provides: {
    a2a: { kind: "http", endpoint: "a2a" },
  },
  exports: {
    a2a: "provides.a2a",
  },
}
