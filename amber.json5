{
  manifest_version: "0.3.0",
  agent: {
    name: "MAizeBargAIn Purple",
    description: "Multi-round bargaining agent",
    image: "ghcr.io/agent-beats-uta/purple-agent-maizebargain:latest",
    port: 9018,
  },
  env: {
    GEMINI_API_KEY: "${secrets.GEMINI_API_KEY}",
    LLM_PROVIDER: "gemini",
  },
}
